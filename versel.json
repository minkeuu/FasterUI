{
  "version": 2,
  "functions": {
    "api/server.cjs": {
      "runtime": "nodejs22.x"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/server.cjs"
    },
    {
      "source": "/uploads/:path*",
      "destination": "/api/server.cjs"
    },
    {
      "source": "/((?!api|uploads|assets|vite.svg|mask-group.png).*)",
      "destination": "/index.html"
    }
  ]
}