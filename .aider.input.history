+                <img
+                  src={avatarUrl}
+                  alt="Avatar"
+                  className="w-24 h-24 rounded-2xl object-cover ring-4 ring-white shadow-lg"
+                />
+                <button
+                  onClick={handleAvatarClick}
+                  disabled={uploadingAvatar}
