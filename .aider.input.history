+                  "radial-gradient(circle at 30% 50%, #7c3aed 0%, transparent 60%), radial-gradient(circle at 80% 20%, #3b82f6 0%, transparent 50%)",
+              }}
+            />
+          </div>
+
+          <div className="px-8 pb-8">
