+                  ref={fileInputRef}
+                  type="file"
+                  accept="image/*"
+                  onChange={handleAvatarChange}
+                  className="hidden"
+                />
+              </div>
+
+              <div className="sm:pb-1">
+                <p className="text-xs text-slate-400">Click the avatar to upload a new photo (max 2 MB)</p>
+              </div>
+            </div>
+
+            {/* Name */}
+            <div className="space-y-2">
+              <label className="text-xs font-semibold text-slate-400 uppercase tracking-wider flex items-center gap-1.5">
+                <User size={12} />
+                Full Name
+              </label>
+              <input
+                value={name}
+                onChange={(e) => setName(e.target.value)}
+                placeholder="Your name"
+                className="w-full text-slate-900 text-lg font-medium border border-slate-200 rounded-xl px-4 py-3 focus:border-violet-400 focus:ring-2 focus:ring-violet-100 outline-none transition-all"
+              />
